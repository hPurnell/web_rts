{
  "name": "web-rts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:determinism": "vitest run test/determinism.test.ts",
    "lint": "eslint .",
    "gen:trig": "tsx tools/gen-trig.ts",
    "gen:golden": "tsx tools/gen-trig-golden.ts",
    "check:browser": "pnpm build && tsx tools/browser-check.ts",
    "gen:golden-sim": "tsx tools/gen-sim-golden.ts",
    "shot": "tsx tools/screenshot.ts",
    "check:bundle": "tsx tools/check-bundle.ts"
  },
  "devDependencies": {
    "@babylonjs/inspector": "^9.26.0",
    "@eslint/js": "^9.13.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.5.1",
    "eslint": "^9.13.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@babylonjs/core": "^9.26.0"
  }
}
